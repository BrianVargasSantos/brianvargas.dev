---
import Base from '../layouts/Base.astro';
---
<Base title="Not found">
  <section class="mx-auto max-w-4xl px-4 py-32 text-center sm:px-6">
    <p class="font-display text-[clamp(6rem,25vw,14rem)] font-extrabold leading-none tracking-tighter text-lime">404</p>
    <p class="mt-4 text-xl text-paper/80">This page wandered off.</p>
    <a href="/" class="mt-10 inline-block rounded-full bg-paper px-6 py-3 font-semibold text-ink hover:bg-lime">Back home</a>
  </section>
</Base>

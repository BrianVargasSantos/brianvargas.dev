---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib';

export async function getStaticPaths() {
  return (await getPosts()).map(p => ({ params: { id: p.id }, props: { post: p } }));
}
const { post } = Astro.props;
const { title, description, date, tags } = post.data;
const { Content } = await render(post);
const pretty = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base title={title} description={description}>
  <article class="mx-auto max-w-3xl px-4 py-20 sm:px-6">
    <a href="/blog" class="font-mono text-sm text-mute hover:text-lime">← All writing</a>
    <h1 class="mt-6 font-display text-[clamp(2.5rem,7vw,4.5rem)] font-extrabold leading-[0.95] tracking-[-0.03em]">{title}</h1>
    <p class="mt-6 flex flex-wrap items-center gap-3 font-mono text-sm text-mute">
      <time datetime={date.toISOString()}>{pretty}</time>
      {tags.map(t => <span class="rounded-full border border-line px-2.5 py-0.5">#{t}</span>)}
    </p>
    <div class="prose prose-invert prose-lg mt-12 max-w-none prose-headings:font-display prose-headings:tracking-tight prose-a:text-lime prose-code:text-lime prose-pre:border prose-pre:border-line">
      <Content />
    </div>
  </article>
</Base>

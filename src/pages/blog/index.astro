---
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import { getPosts } from '../../lib';
const posts = await getPosts();
---
<Base title="Writing" description="Notes on building software, AI tooling, and shipping things.">
  <section class="mx-auto max-w-4xl px-4 py-20 sm:px-6">
    <h1 class="font-display text-[clamp(3.5rem,10vw,8rem)] font-extrabold leading-none tracking-[-0.04em]">Writing<span class="text-coral">.</span></h1>
    <p class="mt-6 max-w-2xl text-xl text-paper/80">Notes on building software, AI tooling, and shipping things. <a href="/rss.xml" class="text-lime underline-offset-4 hover:underline">RSS</a></p>
    <ul class="mt-12">{posts.map(p => <PostRow post={p} />)}</ul>
  </section>
</Base>

---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
interface Props { project: CollectionEntry<'projects'>; big?: boolean; }
const { project, big = false } = Astro.props;
const { title, summary, stack, colors, year, cover } = project.data;
const showCover = big && cover;
---
<a href={`/projects/${project.id}`}
   class:list={['group relative isolate overflow-hidden rounded-3xl border border-line bg-ink-2 transition duration-300 hover:-translate-y-1 hover:border-paper/40',
     big ? 'md:col-span-2' : '',
     showCover ? 'grid md:grid-cols-[1fr_1.15fr]' : 'flex min-h-[20rem] flex-col justify-end']}
   style={`--c1:${colors[0]};--c2:${colors[1]}`}>
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(120%_90%_at_100%_0%,var(--c1),transparent_60%),radial-gradient(90%_80%_at_0%_100%,var(--c2),transparent_55%)] opacity-50 transition duration-500 group-hover:scale-105 group-hover:opacity-80"></div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink via-ink/70 to-ink/10"></div>

  <div class:list={['relative flex flex-col justify-end p-6 sm:p-8', showCover ? 'order-2 md:order-1 md:py-12' : '']}>
    <span class="mb-auto pb-10 font-mono text-xs uppercase tracking-widest text-paper/60">{year} · Case study</span>
    <h3 class:list={['font-display font-extrabold leading-none tracking-tight', big ? 'text-5xl sm:text-6xl' : 'text-4xl']}>{title}</h3>
    <p class="mt-4 max-w-xl text-paper/80">{summary}</p>
    <ul class="mt-6 flex flex-wrap gap-2">
      {stack.map(s => <li class="rounded-full border border-paper/20 bg-ink/50 px-3 py-1 font-mono text-xs">{s}</li>)}
    </ul>
    <span class="mt-8 inline-flex items-center gap-2 font-semibold text-paper transition group-hover:text-lime">
      Read the case study <span aria-hidden="true" class="transition group-hover:translate-x-1">→</span>
    </span>
  </div>

  {showCover && (
    <div class="relative order-1 overflow-hidden px-6 pt-8 md:order-2 md:pl-0 md:pr-0 md:pt-12">
      <Image src={cover} alt={`${title} screenshot`} widths={[600, 900, 1200]} sizes="(min-width: 768px) 600px, 100vw"
        class="w-full rounded-t-xl border border-b-0 border-paper/15 shadow-2xl shadow-black/60 transition duration-500 group-hover:-translate-y-2 md:translate-x-6 md:rounded-tr-none md:border-r-0" />
    </div>
  )}
</a>

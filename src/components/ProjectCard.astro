---
import type { CollectionEntry } from 'astro:content';
interface Props { project: CollectionEntry<'projects'>; big?: boolean; }
const { project, big = false } = Astro.props;
const { title, summary, stack, colors, year } = project.data;
---
<a href={`/projects/${project.id}`}
   class:list={['group relative flex flex-col justify-end overflow-hidden rounded-3xl border border-line p-6 transition duration-300 hover:-translate-y-1 hover:border-paper/40 sm:p-8', big ? 'min-h-[22rem] md:col-span-2 md:min-h-[26rem]' : 'min-h-[20rem]']}
   style={`--c1:${colors[0]};--c2:${colors[1]}`}>
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(120%_90%_at_100%_0%,var(--c1),transparent_60%),radial-gradient(90%_80%_at_0%_100%,var(--c2),transparent_55%)] opacity-70 transition duration-500 group-hover:scale-105 group-hover:opacity-100"></div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink via-ink/60 to-transparent"></div>
  <span class="absolute right-6 top-6 font-mono text-xs text-paper/70">{year}</span>
  <h3 class:list={['font-display font-extrabold leading-none tracking-tight', big ? 'text-5xl sm:text-6xl' : 'text-4xl']}>{title}</h3>
  <p class="mt-3 max-w-xl text-paper/80">{summary}</p>
  <ul class="mt-5 flex flex-wrap gap-2">
    {stack.map(s => <li class="rounded-full border border-paper/20 bg-ink/40 px-3 py-1 font-mono text-xs">{s}</li>)}
  </ul>
  <span class="absolute bottom-6 right-6 grid size-11 place-items-center rounded-full bg-paper text-ink transition group-hover:rotate-[-45deg] group-hover:bg-lime" aria-hidden="true">→</span>
</a>

---
const links = [
  { href: '/projects', label: 'Work' },
  { href: '/blog', label: 'Writing' },
  { href: '/about', label: 'About' },
];
const path = Astro.url.pathname;
---
<header class="sticky top-0 z-40 border-b border-line/60 bg-ink/75 backdrop-blur-md">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
    <a href="/" class="font-display text-xl font-extrabold tracking-tight">BV<span class="text-lime">.</span></a>
    <ul class="flex items-center gap-1 text-sm sm:gap-2">
      {links.map(l => (
        <li>
          <a href={l.href}
             class:list={['rounded-full px-3 py-1.5 transition-colors hover:text-lime', path.startsWith(l.href) ? 'text-lime' : 'text-paper/80']}
             aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>
        </li>
      ))}
      <li><a href="/#contact" class="ml-1 rounded-full bg-lime px-4 py-1.5 font-semibold text-ink transition hover:bg-paper">Hire me</a></li>
    </ul>
  </nav>
</header>

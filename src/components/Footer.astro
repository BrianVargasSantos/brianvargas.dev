---
import { SITE } from '../site';
---
<footer class="border-t border-line">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-10 text-sm text-mute sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <p>© {new Date().getFullYear()} {SITE.name}. Built with Astro.</p>
    <ul class="flex gap-5">
      {SITE.socials.map(s => <li><a class="hover:text-lime" href={s.href} rel="me noopener" target="_blank">{s.label}</a></li>)}
      <li><a class="hover:text-lime" href="/rss.xml">RSS</a></li>
    </ul>
  </div>
</footer>
